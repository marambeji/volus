PORT=3000
NODE_ENV=development

# Database configuration (Preferred connection URL)
# Do NOT append sslmode= here. TLS is controlled by DB_SSL / DB_SSL_REJECT_UNAUTHORIZED below.
DATABASE_URL=postgresql://postgres:password@localhost:5432/hr_portal

# Individual connection parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hr_portal
DB_USERNAME=postgres
DB_PASSWORD=password

# TLS / SSL configuration
# Local PostgreSQL (no TLS):
#   DB_SSL=false
#   DB_SSL_REJECT_UNAUTHORIZED=true   (value ignored when DB_SSL=false)
#
# Supabase / managed cloud DB, dev environment (self-signed cert chain):
#   DB_SSL=true
#   DB_SSL_REJECT_UNAUTHORIZED=false  (development only — do NOT use in production)
#
# Production with a trusted certificate authority:
#   DB_SSL=true
#   DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Allowed CORS origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

